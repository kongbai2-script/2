    Func = function()
        local map = workspace:FindFirstChild("Map")
        if not map then 
            Library:Notify('未找到目标', 2)
            return
        end
        local count = 0
        for _, child in ipairs(map:GetChildren()) do
            local hazard = child:FindFirstChild("Hazard")
            if hazard then
                for _, obj in ipairs(hazard:GetChildren()) do
                    pcall(function() 
                        obj:Destroy() 
                        count = count + 1
                    end)
                end
            end
        end
        Library:Notify('已清除 ' .. count .. ' 个液体', 2)
        if PlayingSound then Sound() end
    end
})

