local doorNoCollideRunning = false
local doorScanningThread = nil

local function MakeDoorPassable(doorModel)
    if processedDoors[doorModel] then return end
    processedDoors[doorModel] = true
    if not doorCanCollideBackup[doorModel] then
        local backup = {}
        for _, part in pairs(doorModel:GetDescendants()) do
            if part:IsA("BasePart") then
                backup[part] = part.CanCollide
            end
        end
        doorCanCollideBackup[doorModel] = backup
    end
    for _, part in pairs(doorModel:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end

local function RestoreDoorCollision(doorModel)
    local backup = doorCanCollideBackup[doorModel]
    if not backup then return end
    for part, originalCollide in pairs(backup) do
        if part and part:IsA("BasePart") then
            part.CanCollide = originalCollide
        end
    end
end

local function RestoreAllDoors()
    for doorModel, _ in pairs(processedDoors) do
        RestoreDoorCollision(doorModel)
    end
    processedDoors = {}
    doorCanCollideBackup = {}
end

local function startDoorNoCollide()
    if doorNoCollideRunning then
        stopDoorNoCollide()
    end
    if not getgenv().DoorNoCollide.Enabled then return end
    doorNoCollideRunning = true
    doorScanningThread = task.spawn(function()
        while not workspace:FindFirstChild("Map") and doorNoCollideRunning do
            task.wait(0.5)
        end
        if not doorNoCollideRunning then return end
        local Map = workspace.Map
        while doorNoCollideRunning and getgenv().DoorNoCollide.Enabled do
            for i = 0, 30 do
                if not doorNoCollideRunning then break end
                local num = tostring(i)
                local outer = Map:FindFirstChild(num)
                if outer then
                    local door = outer:FindFirstChild(num)
                    if door then
                        MakeDoorPassable(door)
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

local function stopDoorNoCollide()
    doorNoCollideRunning = false
    if doorScanningThread then
        task.cancel(doorScanningThread)
        doorScanningThread = nil
    end
    RestoreAllDoors()
end

local function toggleDoorNoCollide()
    if getgenv().DoorNoCollide.Enabled then
        startDoorNoCollide()
    else
        stopDoorNoCollide()
    end
end

