local function lockEnemies()
    if not getgenv().EnemyLock.Enabled then return end
    local enemyFolder = workspace:FindFirstChild("Enemy")
    if enemyFolder then
        for _, humanoid in ipairs(enemyFolder:GetDescendants()) do
            if humanoid:IsA("Humanoid") then
                if humanoid.WalkSpeed ~= 0 then
                    if not originalSpeeds[humanoid] then
                        originalSpeeds[humanoid] = humanoid.WalkSpeed
                    end
                    humanoid.WalkSpeed = 0
                end
            end
        end
    end
end

local function unlockEnemies()
    local enemyFolder = workspace:FindFirstChild("Enemy")
    if enemyFolder then
        for _, humanoid in ipairs(enemyFolder:GetDescendants()) do
            if humanoid:IsA("Humanoid") then
                local original = originalSpeeds[humanoid]
                if original then
                    humanoid.WalkSpeed = original
                elseif humanoid.WalkSpeed == 0 then
                    humanoid.WalkSpeed = 16
                end
            end
        end
    end
    originalSpeeds = {}
end

local function startEnemyLock()
    if enemyLoopConnection then enemyLoopConnection:Disconnect() end
    enemyLoopConnection = runService.RenderStepped:Connect(function()
        if getgenv().EnemyLock.Enabled then
            local enemyFolder = workspace:FindFirstChild("Enemy")
