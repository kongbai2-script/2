local function stopRespawn()
    respawnRunning = false
    if respawnThread then
        coroutine.close(respawnThread)
        respawnThread = nil
    end
end

local function setCameraCFrameSafely(targetCF)
    local maxAttempts = 10
    local attempt = 0
    while attempt < maxAttempts do
        task.wait(0.05)
        local cam = workspace.CurrentCamera
        if cam and cam.Parent then
            cam.CFrame = targetCF
            if (cam.CFrame.Position - targetCF.Position).Magnitude < 0.5 then
                break
            end
        end
        attempt = attempt + 1
    end
end

local function startRespawn()
    if respawnThread then
        coroutine.close(respawnThread)
        respawnThread = nil
    end
    respawnRunning = true
    respawnThread = coroutine.create(function()
        while respawnRunning do
            if not getgenv().AutoRespawn then
                task.wait(0.1)
                continue
            end

            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local humanoidRootPart = char and char:FindFirstChild("HumanoidRootPart")
            local camera = workspace.CurrentCamera

            if humanoid and humanoid.Health > 0 and humanoidRootPart then
                deathCFrame = humanoidRootPart.CFrame
                if camera then
                    deathCameraCFrame = camera.CFrame
                end
            end

            local needRespawn = false
            if humanoid and humanoid.Health <= 0 then
                needRespawn = true
            end
            if LocalPlayer.Team and LocalPlayer.Team.Name == "Raytraxian" then
                needRespawn = true
            end

            if needRespawn then
                pcall(function()
                    diedRemote:FireServer()
                end)
                task.wait(0.38)

                local newChar = LocalPlayer.Character
                if newChar and deathCFrame then
                    local rootPart = newChar:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        rootPart.CFrame = deathCFrame
                    end
                    
                    if deathCameraCFrame then
                        setCameraCFrameSafely(deathCameraCFrame)
                    end
                end
            end
            task.wait(0.1)
        end
    end)
    coroutine.resume(respawnThread)
end

local function enableZap()
    if zapLoopConn then return end
    
    applyZapOnCharacter(LocalPlayer.Character)
    
    zapLoopConn = RunService.Heartbeat:Connect(function()
        if not getgenv().AntiZapDoor then 
            if zapLoopConn then
                zapLoopConn:Disconnect()
                zapLoopConn = nil
            end
            return 
        end
        local c = LocalPlayer.Character
        if c then
            c:SetAttribute("SafezoneImmunity", true)
            c:SetAttribute("SpawnKill", true)
        end
        pcall(function()
            local events = workspace:FindFirstChild("Events")
            if events then
                local barrier = events:FindFirstChild("BarrierEnabled")
                if barrier and barrier.Value ~= false then
                    barrier.Value = false
                end
            end
        end)
    end)
end

local function disableZap()
    if zapLoopConn then
        zapLoopConn:Disconnect()
        zapLoopConn = nil
    end
    
    local char = LocalPlayer.Character
    if char then
        char:SetAttribute("SafezoneImmunity", nil)
        char:SetAttribute("SpawnKill", nil)
    end
    
    pcall(function()
        local events = workspace:FindFirstChild("Events")
        if events then
            local barrier = events:FindFirstChild("BarrierEnabled")
            if barrier then
                barrier.Value = true
            end
        end
    end)
end

local function manualRespawn()
    local currentPos = nil
    local currentCam = nil
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            currentPos = root.CFrame
        end
        local cam = workspace.CurrentCamera
        if cam then
            currentCam = cam.CFrame
        end
    end
    
    pcall(function()
        diedRemote:FireServer()
    end)
    
    task.wait(0.38)
    
    local newChar = LocalPlayer.Character
    if newChar and currentPos then
        local newRoot = newChar:FindFirstChild("HumanoidRootPart")
        if newRoot then
            newRoot.CFrame = currentPos
        end
        if currentCam then
            setCameraCFrameSafely(currentCam)
        end
    end
    
    Library:Notify('已触发', 1)
end

local function enableTaser()
    if taserLoop then return end
    
    taserLoop = RunService.Heartbeat:Connect(function()
        if not getgenv().AntiTaser then
            if taserLoop then
                taserLoop:Disconnect()
                taserLoop = nil
            end
            return
        end
        
        local char = LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                if humanoid:GetAttribute("Stunned") == true then
                    humanoid:SetAttribute("Stunned", false)
                end
                if humanoid:GetAttribute("Tased") == true then
                    humanoid:SetAttribute("Tased", false)
                end
                if humanoid:GetAttribute("Electrocuted") == true then
                    humanoid:SetAttribute("Electrocuted", false)
                end
            end
            
            local stunnedPart = char:FindFirstChild("Stunned")
            if stunnedPart then
                stunnedPart:Destroy()
            end
            
            local tasedPart = char:FindFirstChild("Tased")
            if tasedPart then
                tasedPart:Destroy()
            end
        end
    end)
end

local function disableTaser()
    if taserLoop then
        taserLoop:Disconnect()
        taserLoop = nil
    end
end

local function checkAndEscape()
    if not getgenv().AutoEscape then return end
    
    local char = workspace:FindFirstChild(LocalPlayer.Name)
    if char and char:FindFirstChild("GrabWeld") then
        task.spawn(function()
            while char and char:FindFirstChild("GrabWeld") and getgenv().AutoEscape do
                pcall(function()
                    local escapeRemote = ReplicatedStorage:FindFirstChild("Remote")
                    if escapeRemote then
                        escapeRemote = escapeRemote:FindFirstChild("Grab")
                        if escapeRemote then
                            escapeRemote = escapeRemote:FindFirstChild("Escape")
                            if escapeRemote then
                                escapeRemote:FireServer()
                            end
                        end
                    end
                end)
                task.wait()
            end
        end)
    end
end

local function setupEscapeListener()
    if escapeConn then
        escapeConn:Disconnect()
    end
    if escapeCharConn then
        escapeCharConn:Disconnect()
    end
    
    escapeConn = workspace.ChildAdded:Connect(function(child)
        if child.Name == LocalPlayer.Name then
            task.wait(0.1)
            checkAndEscape()
            if escapeCharConn then
                escapeCharConn:Disconnect()
            end
            escapeCharConn = child.ChildAdded:Connect(function(c)
                if c.Name == "GrabWeld" then
                    checkAndEscape()
                end
            end)
        end
    end)
    
    local char = workspace:FindFirstChild(LocalPlayer.Name)
    if char then
        task.wait(0.1)
        checkAndEscape()
        if escapeCharConn then
            escapeCharConn:Disconnect()
        end
        escapeCharConn = char.ChildAdded:Connect(function(c)
            if c.Name == "GrabWeld" then
                checkAndEscape()
            end
        end)
    end
end

local function disableEscape()
    if escapeConn then
        escapeConn:Disconnect()
        escapeConn = nil
    end
    if escapeCharConn then
        escapeCharConn:Disconnect()
        escapeCharConn = nil
    end
end

