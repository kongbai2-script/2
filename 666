        escapeConn = nil
    end
    if escapeCharConn then
        escapeCharConn:Disconnect()
        escapeCharConn = nil
    end
end

local function getTeleportPosition(targetChar, mode)
    local root = targetChar:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local targetPos = root.Position
    local targetCF = root.CFrame
    
    if mode == "脚底" then
        return targetPos - Vector3.new(0, 5, 0)
    elseif mode == "背后" then
        local backPos = targetCF.Position - targetCF.LookVector * 3
        return backPos
    end
    return targetPos - Vector3.new(0, 5, 0)
end

local function isTeleportTargetValid(target)
    if not target then return false end
    local char = target.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    if LocalPlayer.Team and target.Team == LocalPlayer.Team then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    return true
end

local function getTeleportTarget()
    if getgenv().TeleportTargets and #getgenv().TeleportTargets > 0 then
        for _, name in ipairs(getgenv().TeleportTargets) do
            local p = Players:FindFirstChild(name)
            if p and p ~= LocalPlayer then
                if isTeleportTargetValid(p) then
                    return p
                end
            end
        end
        return nil
    else
        local enemies = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end
            local char = player.Character
            if not char then continue end
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then continue end
            table.insert(enemies, player)
        end
        if #enemies == 0 then return nil end
        return enemies[math.random(1, #enemies)]
    end
end

local function enableTeleport()
    if teleportConnection then return end
    teleportTarget = getTeleportTarget()
    teleportConnection = RunService.RenderStepped:Connect(function()
        if not getgenv().AutoTeleport then return end
        if not isTeleportTargetValid(teleportTarget) then
            teleportTarget = getTeleportTarget()
        end
        if not teleportTarget then return end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local targetChar = teleportTarget.Character
        if not targetChar then return end
        local teleportPos = getTeleportPosition(targetChar, getgenv().TeleportMode)
        if teleportPos then
            myRoot.CFrame = CFrame.new(teleportPos)
        end
    end)
end

local function disableTeleport()
    if teleportConnection then
        teleportConnection:Disconnect()
        teleportConnection = nil
    end
    teleportTarget = nil
end

