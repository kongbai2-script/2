end

local function normalizeTargetList(selection)
    if selection == nil then
        return {}
    end
    local list = {}
    if type(selection[1]) == "string" then
        for _, name in ipairs(selection) do
            table.insert(list, name)
        end
    else
        for name, _ in pairs(selection) do
            if type(name) == "string" then
                table.insert(list, name)
            end
        end
    end
    return list
end

