RunService.RenderStepped:Connect(function()
    if not getgenv().MeleeRange then return end
    if not meleeHookActive then return end
    if not meleeWeaponCallback then return end
    
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    meleeLastAttackFrame = meleeLastAttackFrame + 1
    if meleeLastAttackFrame > 20 then return end
    
    local myTeam = LocalPlayer.Team
    local myPos = myRoot.Position
    local attacked = {}
    
    for _, target in ipairs(Players:GetPlayers()) do
        if target == LocalPlayer then continue end
        
        local targetChar = target.Character
        if not targetChar then continue end
        if attacked[targetChar] then continue end
        
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetRoot then continue end
        
        if (myPos - targetRoot.Position).Magnitude > 10 then
            continue
        end
        
        if myTeam and target.Team == myTeam then continue end
        if not myTeam and not target.Team then continue end
        
        local targetHead = targetChar:FindFirstChild("Head")
        if targetHead then
            attacked[targetChar] = true
            meleeWeaponCallback(targetHead)
        end
    end
end)

