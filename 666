local function startESP()
    if espThread then
        coroutine.close(espThread)
        espThread = nil
    end
    
    espRunning = true
    espThread = coroutine.create(function()
        while espRunning do
            if not getgenv().NightvisionESP then
                removeNightvisionESP()
                task.wait(0.5)
                continue
            end
            
            local terrain = workspace:FindFirstChild("Terrain")
            if terrain then
                local nightvision = terrain:FindFirstChild("Nightvision")
                if nightvision then
                    if not nightvisionBillboard or nightvisionBillboard.Parent ~= nightvision then
                        createNightvisionESP()
                    end
                else
                    removeNightvisionESP()
                end
            else
                removeNightvisionESP()
            end
            
            task.wait(0.5)
        end
    end)
    coroutine.resume(espThread)
end

local function stopESP()
    espRunning = false
    if espThread then
        coroutine.close(espThread)
        espThread = nil
    end
    removeNightvisionESP()
end

local function startNightvisionMonitor()
    if nightvisionThread then
        coroutine.close(nightvisionThread)
        nightvisionThread = nil
    end
    
    nightvisionRunning = true
    setupNightvisionSound()
    nightvisionLastState = false
    
    nightvisionThread = coroutine.create(function()
        local Terrain = workspace:WaitForChild("Terrain")
        
        while nightvisionRunning do
            if not getgenv().NightvisionNotify then
                task.wait(1)
                nightvisionLastState = false
                continue
            end
            
            local currentState = Terrain:FindFirstChild("Nightvision") ~= nil
            
            if currentState and not nightvisionLastState then
                Library:Notify('夜视仪已刷新！', 3)
                
                if nightvisionSound then
                    nightvisionSound:Stop()
                    nightvisionSound:Play()
                end
            end
            
            nightvisionLastState = currentState
            task.wait(1)
        end
    end)
    coroutine.resume(nightvisionThread)
end

local function stopNightvisionMonitor()
    nightvisionRunning = false
    if nightvisionThread then
        coroutine.close(nightvisionThread)
        nightvisionThread = nil
    end
    if nightvisionSound then
        nightvisionSound:Stop()
    end
    nightvisionLastState = false
end

local function AutoGetNightvision()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    local originalPosition = humanoidRootPart.Position

    local nightvision = Workspace.Terrain:FindFirstChild("Nightvision")
    if not nightvision then
        Library:Notify('未找到夜视仪', 2)
        return
    end

    local hitbox = nightvision:FindFirstChild("Hitbox")
    if not hitbox then
        Library:Notify('未找到夜视仪Hitbox', 2)
        return
    end

    humanoidRootPart.CFrame = CFrame.new(hitbox.Position + Vector3.new(0, 3, 0))
    task.wait(0.3)
    
    for _, child in ipairs(hitbox:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            fireproximityprompt(child)
            Library:Notify('已获取夜视仪', 2)
            break
        elseif child:IsA("ClickDetector") then
            child:Click()
            Library:Notify('已获取夜视仪', 2)
            break
        end
    end
    
    task.wait(0.5)
    humanoidRootPart.CFrame = CFrame.new(originalPosition)
end

local function getAllPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(names, p.Name)
        end
