local function setCameraCFrameSafely(targetCF)
    local maxAttempts = 10
    local attempt = 0
    while attempt < maxAttempts do
        task.wait(0.05)
        local cam = workspace.CurrentCamera
        if cam and cam.Parent then
            cam.CFrame = targetCF
            if (cam.CFrame.Position - targetCF.Position).Magnitude < 0.5 then
                break
            end
        end
        attempt = attempt + 1
    end
end

local function startRespawn()
    if respawnThread then
        coroutine.close(respawnThread)
        respawnThread = nil
    end
    respawnRunning = true
    respawnThread = coroutine.create(function()
        while respawnRunning do
            if not getgenv().AutoRespawn then
                task.wait(0.1)
                continue
            end

            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local humanoidRootPart = char and char:FindFirstChild("HumanoidRootPart")
            local camera = workspace.CurrentCamera

            if humanoid and humanoid.Health > 0 and humanoidRootPart then
                deathCFrame = humanoidRootPart.CFrame
                if camera then
                    deathCameraCFrame = camera.CFrame
                end
            end

            local needRespawn = false
            if humanoid and humanoid.Health <= 0 then
                needRespawn = true
            end
            if LocalPlayer.Team and LocalPlayer.Team.Name == "Raytraxian" then
                needRespawn = true
            end

            if needRespawn then
                pcall(function()
                    diedRemote:FireServer()
                end)
                task.wait(0.38)

                local newChar = LocalPlayer.Character
                if newChar and deathCFrame then
                    local rootPart = newChar:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        rootPart.CFrame = deathCFrame
                    end
                    
                    if deathCameraCFrame then
                        setCameraCFrameSafely(deathCameraCFrame)
                    end
                end
            end
            task.wait(0.1)
        end
    end)
    coroutine.resume(respawnThread)
end

local function setupSharkHook()
    if sharkHooked then return end
    local remote = ReplicatedStorage.Remote.TouchEvent
    hookmetamethod(remote, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and getgenv().AntiShark then
            local args = {...}
            if args[1] and typeof(args[1]) == "Instance" and tostring(args[1].Parent):find("Shark") then
                return nil
            end
        end
        local mt = debug.getmetatable(remote)
        if mt and mt.__namecall then
            return mt.__namecall(self, ...)
        end
        return nil
    end))
    sharkHooked = true
end

