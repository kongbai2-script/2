local TouchEvent = ReplicatedStorage.Remote.TouchEvent
local originalNamecall = nil
local hookActive = false

local function updateHook()
    local mt = debug.getmetatable(TouchEvent)
    if not mt then return end
    
    local shouldHook = getgenv().AntiShark or getgenv().AntiYellowBarrel
    
    if shouldHook and not hookActive then
        setreadonly(mt, false)
        originalNamecall = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" then
                local args = {...}
                
                if getgenv().AntiShark then
                    for i, arg in ipairs(args) do
                        if typeof(arg) == "Instance" and arg.Parent then
                            local parentName = tostring(arg.Parent):lower()
                            if parentName:find("shark") then
                                return nil
                            end
                        end
                        if typeof(arg) == "Instance" and arg.Name and arg.Name:lower():find("shark") then
                            return nil
                        end
                    end
                end
                
                if getgenv().AntiYellowBarrel then
                    local selfName = tostring(self):lower()
                    local shouldBlock = false
                    
                    for i, arg in ipairs(args) do
                        if typeof(arg) == "Instance" and arg.Name then
                            local argName = arg.Name:lower()
                            if argName:find("barrel") or argName:find("yellow") or argName == "mainpart" then
                                shouldBlock = true
                                break
                            end
                        end
                        if typeof(arg) == "Instance" and arg.Parent and arg.Parent.Name then
                            local parentName = arg.Parent.Name:lower()
                            if parentName:find("barrel") or parentName:find("yellow") then
                                shouldBlock = true
                                break
                            end
                        end
                    end
                    
                    if selfName:find("barrel") or selfName:find("yellow") then
                        shouldBlock = true
                    end
                    
                    if shouldBlock then
                        return nil
                    end
                end
            end
            return originalNamecall(self, ...)
        end)
        setreadonly(mt, true)
        hookActive = true
    elseif not shouldHook and hookActive then
        setreadonly(mt, false)
        mt.__namecall = originalNamecall
        setreadonly(mt, true)
        hookActive = false
    end
end

local function applyZapOnCharacter(char)
    if not getgenv().AntiZapDoor then return end
    if char then
        char:SetAttribute("SafezoneImmunity", true)
        char:SetAttribute("SpawnKill", true)
    end
    pcall(function()
        local events = workspace:FindFirstChild("Events")
        if events then
            local barrier = events:FindFirstChild("BarrierEnabled")
            if barrier then
                barrier.Value = false
            end
        end
    end)
end

local function enableMeleeRange()
    if meleeActive then return end
    
    if not meleeBarrier then
        meleeBarrier = Instance.new("Part")
        meleeBarrier.Shape = Enum.PartType.Ball
        meleeBarrier.Size = Vector3.new(20, 20, 20)
        meleeBarrier.Anchored = true
        meleeBarrier.CanCollide = false
        meleeBarrier.CanQuery = false
        meleeBarrier.Transparency = 0.5
        meleeBarrier.Color = Color3.new(0, 1, 1)
        meleeBarrier.Material = Enum.Material.ForceField
        meleeBarrier.Parent = workspace
    end
    
    meleeBarrier.Transparency = 0.5
    
    local success, err = pcall(function()
        local defaultDetection = require(ReplicatedStorage.Module.Weapon.DefaultDetection)
        originalDetection = debug.getupvalue(defaultDetection, 1)
        debug.setupvalue(defaultDetection, 1, function() return {} end)
        
        local hitboxModule = debug.getupvalue(defaultDetection, 2)
        originalHitboxNew = hitboxModule.new
        hitboxModule.new = function(...)
            local hitbox = originalHitboxNew(...)
            hitbox.DetectionMode = 3
            local oldConnect = hitbox.OnHit.Connect
            hitbox.OnHit.Connect = function(self, callback)
                return oldConnect(self, function(hitPart)
                    callback(hitPart)
                    if not hitPart then return end
                    local myChar = LocalPlayer.Character
                    if not myChar then return end
                    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
                    if not myRoot then return end
                    local myTeam = LocalPlayer.Team
                    local attacked = {[hitPart.Parent] = true}
                    for _, target in ipairs(Players:GetPlayers()) do
                        if target ~= LocalPlayer and target.Character and not attacked[target.Character] then
                            if myTeam and target.Team == myTeam then continue end
                            if not myTeam and not target.Team then continue end
                            local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
                            if targetRoot and (myRoot.Position - targetRoot.Position).Magnitude <= 20 then
                                local targetHead = target.Character:FindFirstChild("Head")
                                if targetHead then
                                    attacked[target.Character] = true
                                    callback(targetHead)
                                end
                            end
                        end
                    end
                end)
            end
            return hitbox
        end
    end)
    
    if success then
        meleeActive = true
    end
end

local function disableMeleeRange()
    if not meleeActive then return end
    
    if meleeBarrier then
        meleeBarrier.Transparency = 1
    end
    
    pcall(function()
        local defaultDetection = require(ReplicatedStorage.Module.Weapon.DefaultDetection)
        if originalDetection then
            debug.setupvalue(defaultDetection, 1, originalDetection)
        end
        
        local hitboxModule = debug.getupvalue(defaultDetection, 2)
        if hitboxModule and originalHitboxNew then
            hitboxModule.new = originalHitboxNew
        end
    end)
    
    meleeActive = false
end

