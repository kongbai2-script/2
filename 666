    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            currentPos = root.CFrame
        end
        local cam = workspace.CurrentCamera
        if cam then
            currentCam = cam.CFrame
        end
    end
    
    pcall(function()
        diedRemote:FireServer()
    end)
    
    task.wait(0.38)
    
    local newChar = LocalPlayer.Character
    if newChar and currentPos then
        local newRoot = newChar:FindFirstChild("HumanoidRootPart")
        if newRoot then
            newRoot.CFrame = currentPos
        end
        if currentCam then
            setCameraCFrameSafely(currentCam)
        end
    end
    
    Library:Notify('已触发', 1)
end

local function enableTaser()
    if taserHookConn then return end
    
    local rayTrax = ReplicatedStorage:FindFirstChild("Remote")
    if rayTrax then
        rayTrax = rayTrax:FindFirstChild("Raytrax")
    end
    
    if rayTrax then
        local taser = rayTrax:FindFirstChild("Taser")
        if taser then
            local mt = getrawmetatable(taser)
            if mt then
                taserMetatable = mt
                taserOriginalNamecall = mt.__namecall
                setreadonly(mt, false)
                mt.__namecall = function(self, ...)
                    local method = getnamecallmethod()
                    if getgenv().AntiTaser and self == taser and method == "FireServer" then
                        return nil
                    end
                    if taserOriginalNamecall then
                        return taserOriginalNamecall(self, ...)
                    end
                    return nil
                end
                setreadonly(mt, true)
                taserHookConn = true
            end
        end
    end
end

local function disableTaser()
    if not taserHookConn then return end
    
    if taserMetatable and taserOriginalNamecall then
        setreadonly(taserMetatable, false)
        taserMetatable.__namecall = taserOriginalNamecall
        setreadonly(taserMetatable, true)
    end
    
    taserHookConn = false
    taserMetatable = nil
    taserOriginalNamecall = nil
end

local function checkAndEscape()
    if not getgenv().AutoEscape then return end
    
    local char = workspace:FindFirstChild(LocalPlayer.Name)
    if char and char:FindFirstChild("GrabWeld") then
        task.spawn(function()
            while char and char:FindFirstChild("GrabWeld") and getgenv().AutoEscape do
                pcall(function()
                    local escapeRemote = ReplicatedStorage:FindFirstChild("Remote")
                    if escapeRemote then
                        escapeRemote = escapeRemote:FindFirstChild("Grab")
                        if escapeRemote then
                            escapeRemote = escapeRemote:FindFirstChild("Escape")
                            if escapeRemote then
                                escapeRemote:FireServer()
                            end
                        end
                    end
                end)
                task.wait()
            end
        end)
    end
end

local function setupEscapeListener()
    if escapeConn then
        escapeConn:Disconnect()
    end
    if escapeCharConn then
        escapeCharConn:Disconnect()
    end
    
    escapeConn = workspace.ChildAdded:Connect(function(child)
        if child.Name == LocalPlayer.Name then
            task.wait(0.1)
            checkAndEscape()
            if escapeCharConn then
                escapeCharConn:Disconnect()
            end
            escapeCharConn = child.ChildAdded:Connect(function(c)
                if c.Name == "GrabWeld" then
                    checkAndEscape()
                end
            end)
        end
    end)
    
    local char = workspace:FindFirstChild(LocalPlayer.Name)
    if char then
        task.wait(0.1)
        checkAndEscape()
        if escapeCharConn then
            escapeCharConn:Disconnect()
        end
        escapeCharConn = char.ChildAdded:Connect(function(c)
            if c.Name == "GrabWeld" then
                checkAndEscape()
            end
        end)
    end
end

local function disableEscape()
    if escapeConn then
