    Func = function()
        getgenv().TeleportTargets = {}
        if teleportTargetDropdown and teleportTargetDropdown.SetValue then
            teleportTargetDropdown:SetValue({})
        end
        if getgenv().AutoTeleport then
            teleportTarget = getTeleportTarget()
        end
        Library:Notify('目标已清除', 1)
    end
})

NightvisionGroup:AddToggle('NightvisionNotifyToggle', {
    Text = '夜视仪刷新提醒',
    Default = false,
    Callback = function(value)
        getgenv().NightvisionNotify = value
        if value then
            startNightvisionMonitor()
        else
            stopNightvisionMonitor()
        end
    end
})

NightvisionGroup:AddToggle('NightvisionESPToggle', {
    Text = '夜视仪文本透视',
    Default = false,
    Callback = function(value)
        getgenv().NightvisionESP = value
        if value then
            startESP()
        else
            stopESP()
        end
    end
})

NightvisionGroup:AddButton({
    Text = '自动获取夜视仪',
    Func = function()
        AutoGetNightvision()
    end
})

local UIGroupSettings = UISettingsTab:AddLeftGroupbox('界面设置')
UIGroupSettings:AddLabel('菜单快捷键'):AddKeyPicker("MenuKeybind", {
    Default = "RightShift",
    NoUI = false,
    Text = '菜单快捷键'
})
UIGroupSettings:AddDivider()
UIGroupSettings:AddLabel('配置管理', true)

UIGroupSettings:AddButton({
    Text = '卸载脚本',
    Func = function()
        getgenv().AutoRespawn = false
        getgenv().AntiShark = false
        getgenv().AntiZapDoor = false
        getgenv().MeleeRange = false
        getgenv().AntiTaser = false
        getgenv().AutoEscape = false
        getgenv().AutoTeleport = false
        getgenv().NightvisionNotify = false
        getgenv().NightvisionESP = false
        
        stopRespawn()
        disableZap()
        disableMeleeRange()
        disableTaser()
        disableEscape()
        disableTeleport()
        stopNightvisionMonitor()
        stopESP()
        
        task.wait(0.5)
        Library:Unload()
    end
})

Library.ToggleKeybind = Options.MenuKeybind

local folder_path = "开州乐园"
ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)
SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({ 'MenuKeybind' })
ThemeManager:SetFolder(folder_path)
SaveManager:SetFolder(folder_path .. '/Settings')
SaveManager:BuildConfigSection(UISettingsTab)
ThemeManager:ApplyToTab(UISettingsTab)

Players.PlayerAdded:Connect(function() task.wait(0.5) updatePlayerList() end)
Players.PlayerRemoving:Connect(function() task.wait(0.5) updatePlayerList() end)
updatePlayerList()

pcall(function()
    SaveManager:LoadAutoloadConfig()
end)
