local function GetSampleId(sample)
    return tostring(sample)
end

local function GetAllSamples()
    local samples = {}
    local map = workspace:FindFirstChild("Map")
    if not map then return samples end
    
    for _, child in ipairs(map:GetChildren()) do
        if child.Name == "Sample" then
            table.insert(samples, child)
        end
    end
    return samples
end

local function GetSampleCount()
    local map = workspace:FindFirstChild("Map")
    if not map then return 0 end
    
    local count = 0
    for _, child in ipairs(map:GetChildren()) do
        if child.Name == "Sample" then
            count = count + 1
        end
    end
    return count
end

local function UpdateSampleCountDisplay()
    if sampleCountLabel then
        local count = GetSampleCount()
        sampleCountLabel:SetText("样本数量: " .. count)
    end
end

local function NotifySample(count, isNew)
    if isNew then
        Library:Notify("样本已刷新，当前共 " .. count .. " 个", 2)
    end
    if PlayingSound then Sound() end
end

local function FullScan()
    local map = workspace:FindFirstChild("Map")
    if not map then 
        UpdateSampleCountDisplay()
        return 
    end
    
    local currentSampleIds = {}
    local newSamplesFound = false
    
    for _, sample in ipairs(GetAllSamples()) do
        local sampleId = GetSampleId(sample)
        currentSampleIds[sampleId] = true
        
        if not notifiedSamples[sampleId] then
            notifiedSamples[sampleId] = {
                id = sampleId,
                firstSeen = tick(),
                instance = sample
            }
            newSamplesFound = true
        end
    end
    
    for sampleId, _ in pairs(notifiedSamples) do
        if not currentSampleIds[sampleId] then
            notifiedSamples[sampleId] = nil
        end
    end
    
    local currentCount = GetSampleCount()
    UpdateSampleCountDisplay()
    
    if newSamplesFound then
        NotifySample(currentCount, true)
    end
    
    return currentCount
end

local function StartPeriodicScan()
    sampleDetectionThread = task.spawn(function()
        while sampleDetectionActive and getgenv().SampleDetection.Enabled do
            FullScan()
            task.wait(0.3)
        end
    end)
end

local function OnSampleRemoved(sample)
    local sampleId = GetSampleId(sample)
    if notifiedSamples[sampleId] then
        notifiedSamples[sampleId] = nil
        local remainingCount = GetSampleCount()
        UpdateSampleCountDisplay()
        if PlayingSound then Sound() end
    end
end

local function StartSampleDetection()
    if sampleDetectionActive then return end
    if not getgenv().SampleDetection.Enabled then return end
    
    sampleDetectionActive = true
    notifiedSamples = {}
    
    local initialCount = FullScan()
    StartPeriodicScan()
    
    local function SetupListeners(map)
        sampleAddedConnection = map.ChildAdded:Connect(function(child)
            if not getgenv().SampleDetection.Enabled then return end
            if child.Name == "Sample" then
                FullScan()
            end
        end)
        
        sampleRemovedConnection = map.ChildRemoved:Connect(function(child)
            if not getgenv().SampleDetection.Enabled then return end
            if child.Name == "Sample" then
                OnSampleRemoved(child)
            end
        end)
    end
    
    local map = workspace:FindFirstChild("Map")
    if map then
        SetupListeners(map)
    else
        local mapWaitConnection
        mapWaitConnection = workspace.ChildAdded:Connect(function(child)
            if child.Name == "Map" then
                SetupListeners(child)
                mapWaitConnection:Disconnect()
                FullScan()
            end
        end)
    end
    
    Library:Notify('样本检测已启用，当前样本数量: ' .. initialCount, 2)
end

local function StopSampleDetection()
    sampleDetectionActive = false
    
    if sampleDetectionThread then
        task.cancel(sampleDetectionThread)
        sampleDetectionThread = nil
    end
    
    if sampleAddedConnection then
        sampleAddedConnection:Disconnect()
        sampleAddedConnection = nil
    end
    
    if sampleRemovedConnection then
        sampleRemovedConnection:Disconnect()
        sampleRemovedConnection = nil
    end
    
    notifiedSamples = {}
    
    if sampleCountLabel then
        sampleCountLabel:SetText("样本数量: 0")
    end
    
    Library:Notify('样本检测已禁用', 2)
end

local function ToggleSampleDetection()
    if getgenv().SampleDetection.Enabled then
        StartSampleDetection()
    else
        StopSampleDetection()
    end
end

