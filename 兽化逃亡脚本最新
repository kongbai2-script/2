local function GetSelectedWeapon()
    if not player.Character then return nil end
    local weaponName = getgenv().KillAura.SelectedWeapon or "Fists"
    local weapon = player.Character:FindFirstChild(weaponName)
    if weapon then return weapon end
    local backpackWeapon = player.Backpack:FindFirstChild(weaponName)
    if backpackWeapon then
        backpackWeapon.Parent = player.Character
        task.wait(0.1)
        return player.Character:FindFirstChild(weaponName)
    end
    return nil
end

local function GetWeaponValue(displayName)
    for _, weapon in ipairs(AvailableWeapons) do
        if weapon.Name == displayName then
            return weapon.Value
        end
    end
    return "Fists"
end

local function GetWeaponDisplayName(value)
    for _, weapon in ipairs(AvailableWeapons) do
        if weapon.Value == value then
            return weapon.Name
        end
    end
    return "拳头"
end

local function InitKillAura()
    local weapon = GetSelectedWeapon()
    if not weapon then
        Library:Notify('未找到武器: ' .. GetWeaponDisplayName(getgenv().KillAura.SelectedWeapon) .. '，请确保手持该武器', 2)
        return false
    end
    
    local remote = weapon:FindFirstChild("RemoteEvent")
    if not remote then
        Library:Notify('武器没有RemoteEvent', 2)
        return false
    end
    
    local attackPart = weapon:FindFirstChild("ClawL")
    if not attackPart then
        attackPart = weapon:FindFirstChild("ClawR")
    end
    if not attackPart then
        attackPart = weapon
    end
    
    killAuraRemote = remote
    killAuraAttackPart = attackPart
    
    Library:Notify('杀戮光环已初始化 | 武器: ' .. GetWeaponDisplayName(getgenv().KillAura.SelectedWeapon), 2)
    return true
end

local function StartKillAura()
    if killAuraRunning then return end
    if not getgenv().KillAura.Enabled then return end
    
    if not InitKillAura() then
        Library:Notify('杀戮光环初始化失败，请确保手持武器后重新开启', 2)
        return
    end
    
    killAuraRunning = true
    
    killAuraThread = task.spawn(function()
        while killAuraRunning and getgenv().KillAura.Enabled do
            local success = pcall(function()
                local enemyFolder = workspace:FindFirstChild("Enemy")
                if enemyFolder then
                    for _, enemy in ipairs(enemyFolder:GetChildren()) do
                        if not killAuraRunning then break end
                        local humanoid = enemy:FindFirstChild("Humanoid")
                        if humanoid and humanoid.Health > 0 then
                            local targetPart = enemy:FindFirstChild("Head")
                            if not targetPart then
                                targetPart = enemy:FindFirstChild("HumanoidRootPart")
                            end
                            if targetPart then
                                killAuraRemote:FireServer(killAuraAttackPart, targetPart, humanoid, "1", "2")
                            end
                        end
                    end
                end
            end)
            if not success then
                killAuraRunning = false
                break
            end
            task.wait(0.05)
        end
    end)
end

local function StopKillAura()
    killAuraRunning = false
    if killAuraThread then
        task.cancel(killAuraThread)
        killAuraThread = nil
    end
    killAuraRemote = nil
    killAuraAttackPart = nil
end

local function toggleKillAura()
    if getgenv().KillAura.Enabled then
        StartKillAura()
    else
        StopKillAura()
    end
end

