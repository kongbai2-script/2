local function LockEnemySpeed()
    if not getgenv().EnemyLock.Enabled then return end
    
    local enemyFolder = workspace:FindFirstChild("Enemy")
    if not enemyFolder then return end
    
    for _, enemy in ipairs(enemyFolder:GetChildren()) do
        local humanoid = enemy:FindFirstChild("Humanoid")
        if humanoid and humanoid.Health > 0 then
            if not originalSpeeds[humanoid] then
                originalSpeeds[humanoid] = humanoid.WalkSpeed
            end
            if humanoid.WalkSpeed ~= 0 then
                humanoid.WalkSpeed = 0
            end
        end
    end
end

local function RestoreEnemySpeed()
    local enemyFolder = workspace:FindFirstChild("Enemy")
    if enemyFolder then
        for _, enemy in ipairs(enemyFolder:GetChildren()) do
            local humanoid = enemy:FindFirstChild("Humanoid")
            if humanoid and originalSpeeds[humanoid] then
                humanoid.WalkSpeed = originalSpeeds[humanoid]
                originalSpeeds[humanoid] = nil
            elseif humanoid and humanoid.WalkSpeed == 0 then
                humanoid.WalkSpeed = 16
            end
        end
    end
    originalSpeeds = {}
end

