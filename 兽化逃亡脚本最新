local interactionNoCollideRunning = false
local interactionScanningThread = nil

local function MakeInteractionPassable(item)
    if processedInteractions[item] then return end
    processedInteractions[item] = true
    if not interactionCanCollideBackup[item] then
        local backup = {}
        for _, part in pairs(item:GetDescendants()) do
            if part:IsA("BasePart") then
                backup[part] = part.CanCollide
            end
        end
        interactionCanCollideBackup[item] = backup
    end
    for _, part in pairs(item:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end

local function RestoreInteractionCollision(item)
    local backup = interactionCanCollideBackup[item]
    if not backup then return end
    for part, originalCollide in pairs(backup) do
        if part and part:IsA("BasePart") then
            part.CanCollide = originalCollide
        end
    end
end

local function RestoreAllInteractions()
    for item, _ in pairs(processedInteractions) do
        RestoreInteractionCollision(item)
    end
    processedInteractions = {}
    interactionCanCollideBackup = {}
end

local function startInteractionNoCollide()
    if interactionNoCollideRunning then
        stopInteractionNoCollide()
    end
    if not getgenv().InteractionNoCollide.Enabled then return end
    interactionNoCollideRunning = true
    interactionScanningThread = task.spawn(function()
        while not workspace:FindFirstChild("Map") and interactionNoCollideRunning do
            task.wait(0.5)
        end
        if not interactionNoCollideRunning then return end
        local Map = workspace.Map
        while interactionNoCollideRunning and getgenv().InteractionNoCollide.Enabled do
            for i = 0, 30 do
                if not interactionNoCollideRunning then break end
                local room = Map:FindFirstChild(tostring(i))
                if room then
                    local interaction = room:FindFirstChild("Interaction")
                    if interaction then
                        for _, obj in ipairs(interaction:GetChildren()) do
                            if obj.Name == "Interaction" or obj:IsA("BasePart") then
                                MakeInteractionPassable(obj)
                            end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

local function stopInteractionNoCollide()
    interactionNoCollideRunning = false
    if interactionScanningThread then
        task.cancel(interactionScanningThread)
        interactionScanningThread = nil
    end
    RestoreAllInteractions()
end

local function toggleInteractionNoCollide()
    if getgenv().InteractionNoCollide.Enabled then
        startInteractionNoCollide()
    else
        stopInteractionNoCollide()
    end
end

-- ========== 自动拾取钥匙卡功能 ==========
local function AutoPickupKeycard()
    local mapFolder = workspace:WaitForChild("Map")
    local char = player.Character
    if not char then 
        Library:Notify("未找到角色", 2)
        return 
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        Library:Notify("未找到HumanoidRootPart", 2)
        return 
    end

    local startPos = hrp.CFrame
    local playerPos = hrp.Position
    local nearestPrompt = nil
    local nearestDist = math.huge
    local nearestParent = nil

    for i = 0, 30 do
        local room = mapFolder:FindFirstChild(tostring(i))
        if room and room:IsA("Model") then
            for _, v in pairs(room:GetDescendants()) do
                if v:IsA("ProximityPrompt") and v.ObjectText == "Keycard" and v.Enabled then
                    local parent = v.Parent
                    if parent and parent.Name == "Keycard" and parent:IsA("UnionOperation") then
                        local card = parent.Parent
                        if card and card.Name == "Card" and card:IsA("Folder") then
                            local dist = (parent.Position - playerPos).Magnitude
                            if dist < nearestDist then
                                nearestDist = dist
                                nearestPrompt = v
                                nearestParent = parent
                            end
                        end
                    end
                end
            end
        end
    end

    if nearestPrompt and nearestParent then
        hrp.CFrame = nearestParent.CFrame * CFrame.new(0, 0, 2)
        task.wait(0.3)
        fireproximityprompt(nearestPrompt)
        task.wait(0.3)
        fireproximityprompt(nearestPrompt)
        task.wait(0.5)
        hrp.CFrame = startPos
        Library:Notify("已自动拾取钥匙卡", 2)
        if PlayingSound then Sound() end
    else
        Library:Notify("未找到钥匙卡", 2)
        if PlayingSound then Sound() end
    end
end

-- ========== 自动刷卡功能 ==========
local function AutoSwipeCard()
    local mapFolder = workspace:WaitForChild("Map")
    local char = player.Character
    if not char then 
        Library:Notify("未找到角色", 2)
        return 
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        Library:Notify("未找到HumanoidRootPart", 2)
        return 
    end

    local startPos = hrp.CFrame
    local found = false

    for i = 0, 30 do
        local room = mapFolder:FindFirstChild(tostring(i))
        if room and room:IsA("Model") and not found then
            for _, v in pairs(room:GetDescendants()) do
                if v.Name == "Part2" and v:IsA("BasePart") then
                    local prompt = v:FindFirstChild("_ProximityPrompt")
                    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        hrp.CFrame = v.CFrame * CFrame.new(0, 0, 2)
                        task.wait(0.3)
                        fireproximityprompt(prompt)
                        task.wait(0.8)
                        fireproximityprompt(prompt)
                        task.wait(0.5)
                        hrp.CFrame = startPos
                        Library:Notify("已自动刷卡", 2)
                        if PlayingSound then Sound() end
                        found = true
                        break
                    end
                end
            end
        end
    end

    if not found then
        Library:Notify("未找到刷卡器", 2)
        if PlayingSound then Sound() end
    end
end

